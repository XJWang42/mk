#!/bin/bash
#SBATCH --job-name=psmc
#SBATCH --output=psmc.%A.%a.out
#SBATCH --error=psmc.%A.%a.err
#SBATCH --array=1-22%4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=20G    # memory per cpu-core
#SBATCH --time=48:00:00
#SBATCH --partition=cpuqueue

module load gsl/2.5
module load perl
module load bcftools
module load gcc/13.2.0
module load gnuplot
module load psmc/0.6.5
module load samtools/1.19.2

sample=$(sed -n "$SLURM_ARRAY_TASK_ID"p MK.list | awk -F'\t' '{print $1}')

samtools consensus -f fastq -A --min-MQ 30 --min-BQ 30 -d 5 /projects/erode/people/bth331/kestrel/bam_falco/${sample}_h.bam -o $sample.psmc.fq
gzip $sample.psmc.fq
fq2psmcfa -q30 $sample.psmc.fq.gz > $sample.psmcfa
splitfa $sample.psmcfa > $sample.split.psmcfa

psmc -N30 -t5 -r5 -p "1+1+1+1+30*2+4+6+10" -o $sample.psmc $sample.psmcfa
seq 10 | xargs -i echo psmc -N30 -t5 -r5 -b -p "1+1+1+1+30*2+4+6+10" \ -o ./bootstrap/$sample.bootstrap.{}.psmc $sample.split.psmcfa | sh
