#!/bin/bash
#SBATCH --job-name=flag
#SBATCH --array=2-22%4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8G    # memory per cpu-core
#SBATCH --time=0:40:00
#SBATCH --partition=cpuqueue

module load python/3.9.5
module load openjdk/17.0.8
module load gatk/4.4.0.0

sample_name=$(sed -n "$SLURM_ARRAY_TASK_ID"p mk_fq2.list | awk -F'\t' '{print $1}')

gatk DownsampleSam -I ${sample_name}.bam -O ${sample_name}_ds.bam -P 0.2
