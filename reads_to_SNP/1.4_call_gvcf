#!/bin/bash
#SBATCH --job-name=gatk_call
#SBATCH --output=gatk_call.%A.%a.out
#SBATCH --error=gatk_call.%A.%a.err
#SBATCH --array=1-22%4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu=8G    # memory per cpu-core
#SBATCH --time=06:00:00
#SBATCH --partition=gpuqueue
#SBATCH --gres=gpu:1

ref_dir="/projects/erode/data/reference_genomes/Mauritius/chrom_level_realtives/0_falcons/Falco_punctatus/GCA_963210335.1/"
ref_fasta="GCA_963210335.1_bFalPun1.1_genomic.fasta"
input_dir="/projects/erode/people/bth331/kestrel/bam/"
output_dir="/projects/erode/people/bth331/kestrel/gvcf/"
sample_name=$(sed -n "$SLURM_ARRAY_TASK_ID"p ${input_dir}mk_fq2.list | awk '{print $1}')

singularity run \
        --bind ${ref_dir}:/ref \
        --bind ${input_dir}:/input \
        --bind ${output_dir}:/output \
        --nv /projects/erode/apps/gpu/parabricks.sif \
        pbrun haplotypecaller \
        --ref /ref/${ref_fasta} \
        --in-bam /input/${sample_name}.bam \
        --gvcf \
        --out-variants /output/${sample_name}.g.vcf.gz \
        --tmp-dir /input/tmp
