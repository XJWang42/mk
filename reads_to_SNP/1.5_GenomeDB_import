#!/bin/bash
#SBATCH --job-name=genDB
#SBATCH --output=genDB.%A.%a.out
#SBATCH --error=genDB.%A.%a.err
#SBATCH --array=4%1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=12G    # memory per cpu-core
#SBATCH --time=144:00:00
#SBATCH --partition=cpuqueue

input_dir="/projects/erode/people/bth331/kestrel/bam/"
chr_name=$(sed -n "$SLURM_ARRAY_TASK_ID"p ${input_dir}mk_scaffold.list | awk '{print $1}')

module load python/3.9.5
module load openjdk/17.0.8
module load gatk/4.4.0.0

gatk --java-options "-Xmx80g -Xms8g -XX:ParallelGCThreads=8" GenomicsDBImport --genomicsdb-workspace-path ./${chr_name} --batch-size 50 -L ${chr_name} --sample-name-map gvcf_falco.list --tmp-dir ./tmp --reader-threads 8
